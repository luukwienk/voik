rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users upload recordings to their own folder. Invite-only access is
    // enforced in firestore.rules and in onAudioUploaded, which deletes
    // uploads from accounts that are not on the allowlist.
    match /transcriptions/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null || request.resource.size < 300 * 1024 * 1024);
    }
  }
}
