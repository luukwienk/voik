rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Invite-only: config/access { emails: [...] } lists who may use Voik.
    // Managed in the console, never readable or writable from clients.
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in
           get(/databases/$(database)/documents/config/access).data.emails;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId && isAllowed();
    }
  }
}
